<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Width="368" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,14">
  <Grid.Resources>
    <SolidColorBrush x:Key="Ink" Color="#ECF4F8"/>
    <SolidColorBrush x:Key="Muted" Color="#A0B3C2"/>
    <SolidColorBrush x:Key="Live" Color="#71E3B5"/>
    <SolidColorBrush x:Key="Warn" Color="#FFC584"/>
    <SolidColorBrush x:Key="Seeker" Color="#9CCFFF"/>
    <Style x:Key="Text" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="FontSize" Value="12"/><Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource Text}">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="11"/>
    </Style>
    <Style x:Key="Status" TargetType="TextBlock" BasedOn="{StaticResource Text}">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tone}" Value="live"><Setter Property="Foreground" Value="{StaticResource Live}"/></DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="seeker"><Setter Property="Foreground" Value="{StaticResource Seeker}"/></DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="warn"><Setter Property="Foreground" Value="{StaticResource Warn}"/></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="StationIcon" TargetType="Path">
      <Setter Property="Stroke" Value="{StaticResource Muted}"/><Setter Property="StrokeThickness" Value="1.4"/>
      <Setter Property="Width" Value="12"/><Setter Property="Height" Value="12"/>
      <Setter Property="Stretch" Value="Uniform"/><Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="SourceIcon" TargetType="Path" BasedOn="{StaticResource StationIcon}">
      <Setter Property="Stroke" Value="{StaticResource Muted}"/>
      <Style.Triggers><DataTrigger Binding="{Binding SourceActive}" Value="True"><Setter Property="Stroke" Value="{StaticResource Live}"/></DataTrigger></Style.Triggers>
    </Style>
    <Style x:Key="DirectorIcon" TargetType="Path" BasedOn="{StaticResource StationIcon}">
      <Setter Property="Stroke" Value="{StaticResource Muted}"/>
      <Style.Triggers><DataTrigger Binding="{Binding DirectorActive}" Value="True"><Setter Property="Stroke" Value="{StaticResource Live}"/></DataTrigger></Style.Triggers>
    </Style>
    <DataTemplate x:Key="Leg">
      <Grid x:Name="LineGroup" Height="12" Margin="3,0">
        <Path x:Name="Dashes" Data="M0,0 L20,0" Stretch="Fill" VerticalAlignment="Center" Stroke="#657785" StrokeThickness="1.3" StrokeDashArray="2 2"/>
        <Grid x:Name="Arrow" Visibility="Collapsed">
          <Border Background="{StaticResource Live}" Height="1.5" VerticalAlignment="Center" Margin="0,0,2,0"/>
          <Path Data="M0,0 L4,3 L0,6" Stroke="{StaticResource Live}" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
        <Border x:Name="Break" Background="#14232E" Width="9" Visibility="Collapsed" HorizontalAlignment="Center">
          <Path Data="M1,1 L7,7 M7,1 L1,7" Stroke="{StaticResource Warn}" StrokeThickness="1.5" VerticalAlignment="Center"/>
        </Border>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding}" Value="live">
          <Setter TargetName="Dashes" Property="Visibility" Value="Collapsed"/><Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding}" Value="broken">
          <Setter TargetName="Dashes" Property="Stroke" Value="{StaticResource Warn}"/><Setter TargetName="Break" Property="Visibility" Value="Visible"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding}" Value="hidden"><Setter TargetName="LineGroup" Property="Visibility" Value="Collapsed"/></DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <Style x:Key="MissileButton" TargetType="ToggleButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="ButtonSurface" Background="Transparent" BorderBrush="#34434D" BorderThickness="0,1,0,0">
            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="#243540"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <DataTemplate x:Key="MissileRow">
      <Border x:Name="RowFrame" BorderThickness="2,0,0,0">
        <Border.Style><Style TargetType="Border">
          <Setter Property="BorderBrush" Value="Transparent"/>
          <Style.Triggers><DataTrigger Binding="{Binding Selected}" Value="True">
            <Setter Property="BorderBrush" Value="{StaticResource Seeker}"/>
            <Setter Property="Background" Value="#252F3B"/>
          </DataTrigger></Style.Triggers>
        </Style></Border.Style>
        <StackPanel Margin="7,0,5,0">
          <Grid MinHeight="28">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="16"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="WeaponLabel" Text="{Binding WeaponLabel}" Style="{StaticResource Text}" FontWeight="Bold"
                       Margin="0,0,5,0" ToolTipService.ToolTip="{Binding WeaponLabel}"/>
            <TextBlock x:Name="TargetBriefLabel" Grid.Column="1" Text="{Binding TargetBrief}" Style="{StaticResource Caption}"
                       Margin="0,0,6,0" ToolTipService.ToolTip="{Binding TargetLabel}"/>
            <TextBlock x:Name="StatusLabel" Grid.Column="2" Text="{Binding CompactState}" Style="{StaticResource Status}"
                       ToolTipService.ToolTip="{Binding ControlHint}"/>
            <Path x:Name="DisclosureChevron" Grid.Column="3" Data="M2,1 L6,5 2,9" Stroke="{StaticResource Muted}" StrokeThickness="1.4"
                  HorizontalAlignment="Right" VerticalAlignment="Center" ToolTipService.ToolTip="展开或收起链路详情"/>
          </Grid>
          <TextBlock x:Name="GapReasonLabel" Text="{Binding GapReason}" Margin="0,0,0,4" TextWrapping="Wrap"
                     ToolTipService.ToolTip="{Binding HopDetail}">
            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
              <Setter Property="Foreground" Value="{StaticResource Warn}"/>
              <Style.Triggers><DataTrigger Binding="{Binding GapReason}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
            </Style></TextBlock.Style>
          </TextBlock>
          <TextBlock x:Name="AlertLabel" Text="{Binding Alert}" Margin="0,0,0,4" TextWrapping="Wrap" ToolTipService.ToolTip="{Binding Alert}">
            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
              <Setter Property="Foreground" Value="{StaticResource Live}"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding TargetWarning}" Value="True"><Setter Property="Foreground" Value="{StaticResource Warn}"/></DataTrigger>
                <DataTrigger Binding="{Binding Alert}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
              </Style.Triggers>
            </Style></TextBlock.Style>
          </TextBlock>
          <StackPanel x:Name="RowDetails" Visibility="Collapsed" Margin="0,0,0,6">
            <Grid Height="23" ToolTipService.ToolTip="{Binding ControlHint}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition/><ColumnDefinition Width="23"/><ColumnDefinition/><ColumnDefinition Width="23"/><ColumnDefinition Width="16"/>
              </Grid.ColumnDefinitions>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Path x:Name="SourceIcon" Style="{StaticResource SourceIcon}" Data="M12,2 A10,10 0 1 1 11.99,2 M12,6 A6,6 0 1 0 18,12 M12,12 L19,5"/>
                <TextBlock x:Name="SourceLabel" Grid.Column="1" Text="{Binding SourceLabel}" Style="{StaticResource Caption}" ToolTipService.ToolTip="{Binding SourceLabel}"/>
              </Grid>
              <ContentPresenter x:Name="FirstSegment" Grid.Column="1" Content="{Binding FirstLeg}" ContentTemplate="{StaticResource Leg}" VerticalAlignment="Center"/>
              <Grid Grid.Column="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Path x:Name="DirectorIcon" Style="{StaticResource DirectorIcon}" Data="M12,9 L7,21 17,21 Z M8,7 C6,9 6,12 8,14 M16,7 C18,9 18,12 16,14 M5,4 C1,8 1,13 4,17 M19,4 C23,8 23,13 20,17"/>
                <TextBlock x:Name="DirectorLabel" Grid.Column="1" Text="{Binding DirectorLabel}" Style="{StaticResource Caption}" ToolTipService.ToolTip="{Binding DirectorLabel}"/>
              </Grid>
              <ContentPresenter x:Name="LastSegment" Grid.Column="3" Content="{Binding LastLeg}" ContentTemplate="{StaticResource Leg}" VerticalAlignment="Center"/>
              <Path Grid.Column="4" ToolTipService.ToolTip="{Binding WeaponRole}">
                <Path.Style><Style TargetType="Path" BasedOn="{StaticResource StationIcon}">
                  <Setter Property="Data" Value="M5,16 L9,11 9,7 12,5 13,8 C16,4 18,3 21,3 21,6 19,10 16,12 L19,13 17,16 13,16 8,20 8,17 Z M4,20 L2,22"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ExternalActive}" Value="True"><Setter Property="Stroke" Value="{StaticResource Live}"/></DataTrigger>
                    <DataTrigger Binding="{Binding Seeker}" Value="True"><Setter Property="Stroke" Value="{StaticResource Seeker}"/><Setter Property="Data" Value="M3,9 L3,3 9,3 M15,3 L21,3 21,9 M21,15 L21,21 15,21 M9,21 L3,21 3,15 M12,8 A4,4 0 1 1 11.99,8"/></DataTrigger>
                    <DataTrigger Binding="{Binding Tone}" Value="warn"><Setter Property="Stroke" Value="{StaticResource Warn}"/></DataTrigger>
                  </Style.Triggers>
                </Style></Path.Style>
              </Path>
            </Grid>
            <Grid MinHeight="20" ToolTipService.ToolTip="{Binding TargetStatus}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Path x:Name="TargetSymbol" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" StrokeThickness="1.4">
                <Path.Style><Style TargetType="Path"><Setter Property="Stroke" Value="{StaticResource Seeker}"/>
                  <Setter Property="Data" Value="M2,7 L2,2 7,2 M13,2 L18,2 18,7 M18,13 L18,18 13,18 M7,18 L2,18 2,13 M10,6 A4,4 0 1 1 9.99,6"/>
                  <Style.Triggers><DataTrigger Binding="{Binding TargetWarning}" Value="True"><Setter Property="Stroke" Value="{StaticResource Warn}"/><Setter Property="Data" Value="M10,1 L20,19 0,19 Z M10,6 L10,12 M10,15 L10,16"/></DataTrigger></Style.Triggers>
                </Style></Path.Style>
              </Path>
              <TextBlock x:Name="CommandTargetLabel" Grid.Column="1" Text="{Binding TargetLabel}" Style="{StaticResource Text}" Margin="0,0,5,0" ToolTipService.ToolTip="{Binding TargetLabel}"/>
              <TextBlock x:Name="SeekerTargetLabel" Grid.Column="2" Text="{Binding SeekerLabel}" Style="{StaticResource Caption}" ToolTipService.ToolTip="{Binding SeekerLabel}"/>
            </Grid>
            <Grid Margin="16,0,0,0" ToolTipService.ToolTip="{Binding ControlHint}">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="HopNoteLabel" Text="{Binding Note}" Style="{StaticResource Caption}" Visibility="Collapsed" ToolTipService.ToolTip="{Binding Note}"/>
              <TextBlock x:Name="AgeLabel" Grid.Column="1" Text="{Binding Age}" Style="{StaticResource Caption}" Margin="5,0,0,0" ToolTipService.ToolTip="{Binding Detail}"/>
            </Grid>
            <TextBlock x:Name="HopDetailLabel" Text="{Binding HopDetail}" Margin="16,2,0,0" TextWrapping="Wrap" TextTrimming="None">
              <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                <Setter Property="Foreground" Value="{StaticResource Warn}"/>
                <Style.Triggers><DataTrigger Binding="{Binding HopDetail}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
              </Style></TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding GapReason}" Value="{x:Null}"><Setter TargetName="HopNoteLabel" Property="Visibility" Value="Visible"/></DataTrigger>
        <DataTrigger Binding="{Binding Note}" Value="{x:Null}"><Setter TargetName="HopNoteLabel" Property="Visibility" Value="Collapsed"/></DataTrigger>
        <DataTrigger Binding="{Binding Age}" Value="{x:Null}"><Setter TargetName="AgeLabel" Property="Visibility" Value="Collapsed"/></DataTrigger>
        <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ToggleButton}}}" Value="True">
          <Setter TargetName="RowDetails" Property="Visibility" Value="Visible"/>
          <Setter TargetName="DisclosureChevron" Property="Data" Value="M1,2 L5,6 9,2"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <Style x:Key="ScrollAreaButton" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ListScrollBar" TargetType="ScrollBar">
      <Setter Property="Width" Value="9"/><Setter Property="Margin" Value="4,0,0,3"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Grid Background="#14232E">
          <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
            <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollAreaButton}"/></Track.DecreaseRepeatButton>
            <Track.Thumb><Thumb MinHeight="20">
              <Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="Grip" Background="#607D8E" CornerRadius="3"/>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="#9CCFFF"/></Trigger></ControlTemplate.Triggers>
              </ControlTemplate></Thumb.Template>
            </Thumb></Track.Thumb>
            <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollAreaButton}"/></Track.IncreaseRepeatButton>
          </Track>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ListViewport" TargetType="ScrollViewer">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollViewer">
        <Grid Background="{TemplateBinding Background}" ClipToBounds="True">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" CanContentScroll="{TemplateBinding CanContentScroll}"/>
          <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Orientation="Vertical" Style="{StaticResource ListScrollBar}"
                     Value="{TemplateBinding VerticalOffset}" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                     Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="HeaderButton" TargetType="Button">
      <Setter Property="Height" Value="24"/><Setter Property="Focusable" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="ButtonSurface" Background="Transparent" CornerRadius="2" Padding="5,0">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="#30434F"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Grid.Resources>
  <Border Background="#F019242E" BorderBrush="#52636F" BorderThickness="1" CornerRadius="4">
    <StackPanel Margin="5,3">
      <Grid Height="27">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="HeaderTitle" Text="制导链路" Style="{StaticResource Text}" FontWeight="Bold" Margin="4,0,0,0"/>
        <TextBlock x:Name="Count" Grid.Column="1" Style="{StaticResource Text}" Margin="6,0,0,0"/>
        <TextBlock x:Name="Context" Grid.Column="2" Style="{StaticResource Caption}" Margin="8,0,3,0"
                   ToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        <Button x:Name="Capabilities" Grid.Column="3" Style="{StaticResource HeaderButton}" Visibility="Collapsed" ToolTipService.ToolTip="查看挂载导弹和雷达能否参与本模组协同">
          <TextBlock Text="装备能力" Style="{StaticResource Caption}" Foreground="{StaticResource Seeker}"/>
        </Button>
        <Button x:Name="Fold" Grid.Column="4" Width="24" Style="{StaticResource HeaderButton}" ToolTipService.ToolTip="收起或展开导弹列表">
          <Path x:Name="FoldIcon" Data="M1,2 L6,7 11,2" Stroke="{StaticResource Muted}" StrokeThickness="1.5" RenderTransformOrigin="0.5,0.5"/>
        </Button>
      </Grid>
      <ScrollViewer x:Name="CapabilityDetails" Style="{StaticResource ListViewport}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="160" Visibility="Collapsed" Margin="5,3,5,4">
        <TextBlock x:Name="CapabilityText" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None"/>
      </ScrollViewer>
      <ScrollViewer x:Name="Viewport" Style="{StaticResource ListViewport}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="300" CanContentScroll="False" Focusable="False" Background="Transparent">
        <StackPanel x:Name="Rows"/>
      </ScrollViewer>
    </StackPanel>
  </Border>
</Grid>
