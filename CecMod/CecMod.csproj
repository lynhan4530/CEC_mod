<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>CecMod</AssemblyName>
    <RootNamespace>CecMod</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
    <ImplicitUsings>disable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>portable</DebugType>
    <!-- Game/BepInEx locations on this machine (see CLAUDE.md). Override on the CLI with
         -p:GameDir=... if the game lives elsewhere. -->
    <GameDir Condition="'$(GameDir)' == ''">G:\Program Files (x86)\Steam\steamapps\common\Sea Power</GameDir>
    <ManagedDir>$(GameDir)\Sea Power_Data\Managed</ManagedDir>
    <BepInExCore>$(GameDir)\BepInEx\core</BepInExCore>
    <AnchorChainDll Condition="'$(AnchorChainDll)' == ''">$([System.IO.Path]::GetFullPath('$(GameDir)\..\..\workshop\content\1286220\3380210757\AnchorChain.dll'))</AnchorChainDll>
  </PropertyGroup>

  <ItemGroup>
    <!-- BepInEx 5 + Harmony + Anchor Chain -->
    <Reference Include="AnchorChain">
      <HintPath>$(AnchorChainDll)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCore)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCore)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Game assemblies -->
    <Reference Include="Seapower-Scripts">
      <HintPath>$(ManagedDir)\Seapower-Scripts.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Unity + UniRx (ReactiveProperty .Value on IsOn / ConnectionLost etc.) -->
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(ManagedDir)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UniRx">
      <HintPath>$(ManagedDir)\UniRx.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
